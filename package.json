{
  "name": "besh",
  "version": "0.4.0-alpha.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "setup": "bun scripts/dev.ts",
    "dev": "bun scripts/dev.ts",
    "dev:api": "bun --watch src/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "start": "bun src/index.ts",
    "test": "bun test ./test",
    "test:e2e": "bun run build && playwright test",
    "preview:all": "bun scripts/preview.ts",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run typecheck && bun run test && bun run build && bun run format:check"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "1.3.12",
    "@radix-ui/react-select": "2.3.8",
    "@radix-ui/react-slot": "1.4.0",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "elysia": "1.4.30",
    "graphql": "17.0.2",
    "lucide-react": "1.53.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "read-excel-file": "9.3.12",
    "saxen": "11.2.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  }
}
