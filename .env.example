# Optional. Basic setup uses the browser wizard without an .env file.
PORT=3000
BESH_HOST=127.0.0.1
BESH_DATABASE_PATH=data/besh.sqlite
BESH_BACKUP_DIR=data/backups

# Optional encryption key file for product-login connections.
# Defaults to besh-secrets.key beside the SQLite database, created when needed.
# Back up this file privately alongside the database; never commit it.
# BESH_SECRET_KEY_PATH=data/besh-secrets.key

# Optional. Load testing downloads a verified k6 binary on first use.
# Use an existing trusted binary or change the writable cache directory.
# BESH_K6_PATH=/absolute/path/to/k6
# BESH_K6_CACHE_DIR=.cache/k6

# Optional trusted private directory for temporary generated backend modules.
# Defaults to a unique OS temporary directory; no setup is required.
# BESH_RUNTIME_CODE_DIR=data/runtime-code

# Recovery / automated provisioning only. Generate at least 32 random characters.
# Setting this replaces the owner token on every server start.
# BESH_ADMIN_TOKEN=

# Optional setup challenge. Normally generated for each unconfigured server start.
# BESH_SETUP_KEY=

# Exact browser origin for session/login CSRF checks and printed setup URL.
# Required behind a reverse proxy. HTTPS required outside loopback development.
# No path/trailing slash. Forwarded headers are never trusted for authentication.
# Dev command sets this automatically.
# BESH_WEB_URL=http://127.0.0.1:5173

# Vite proxy target if the API runs on a different port.
# BESH_API_URL=http://127.0.0.1:3000
